generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model caixa_movimentacoes {
  id              Int           @id @default(autoincrement())
  caixa_sessao_id Int
  tipo            String        @db.VarChar(15)
  valor           Decimal       @db.Decimal(12, 2)
  descricao       String?       @db.VarChar(255)
  criado_em       DateTime      @default(now()) @db.Timestamptz(6)
  caixa_sessoes   caixa_sessoes @relation(fields: [caixa_sessao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([caixa_sessao_id], map: "idx_caixa_mov_sessao")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model caixa_sessoes {
  id                  Int                   @id @default(autoincrement())
  usuario_id          Int
  valor_abertura      Decimal               @default(0) @db.Decimal(12, 2)
  valor_fechamento    Decimal?              @db.Decimal(12, 2)
  status              String                @default("aberto") @db.VarChar(10)
  aberto_em           DateTime              @default(now()) @db.Timestamptz(6)
  fechado_em          DateTime?             @db.Timestamptz(6)
  caixa_movimentacoes caixa_movimentacoes[]
  usuarios            usuarios              @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model categorias {
  id       Int        @id @default(autoincrement())
  nome     String     @unique @db.VarChar(100)
  produtos produtos[]
}

model clientes {
  id             Int              @id @default(autoincrement())
  nome           String           @db.VarChar(150)
  documento      String?          @unique @db.VarChar(20)
  email          String?          @db.VarChar(150)
  telefone       String?          @db.VarChar(20)
  endereco       String?
  limite_credito Decimal?         @default(0) @db.Decimal(12, 2)
  ativo          Boolean          @default(true)
  criado_em      DateTime         @default(now()) @db.Timestamptz(6)
  numero         String?          @db.VarChar(20)
  bairro         String?          @db.VarChar(100)
  cidade         String?          @db.VarChar(100)
  estado         String?          @db.VarChar(2)
  observacoes    String?
  contas_receber contas_receber[]
  vendas         vendas[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model contas_pagar {
  id              Int       @id @default(autoincrement())
  descricao       String    @db.VarChar(255)
  fornecedor      String?   @db.VarChar(150)
  valor           Decimal   @db.Decimal(12, 2)
  vencimento      DateTime  @db.Date
  status          String    @default("aberta") @db.VarChar(10)
  pago_em         DateTime? @db.Timestamptz(6)
  criado_em       DateTime  @default(now()) @db.Timestamptz(6)
  categoria       String?   @db.VarChar(100)
  forma_pagamento String?   @db.VarChar(30)

  @@index([status], map: "idx_contas_pagar_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model contas_receber {
  id              Int       @id @default(autoincrement())
  cliente_id      Int?
  venda_id        Int?
  descricao       String    @db.VarChar(255)
  valor           Decimal   @db.Decimal(12, 2)
  vencimento      DateTime  @db.Date
  status          String    @default("pendente") @db.VarChar(10)
  recebido_em     DateTime? @db.Timestamptz(6)
  criado_em       DateTime  @default(now()) @db.Timestamptz(6)
  categoria       String?   @db.VarChar(100)
  forma_pagamento String?   @db.VarChar(30)
  clientes        clientes? @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendas          vendas?   @relation(fields: [venda_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "idx_contas_receber_status")
}

model devolucao_itens {
  id            Int         @id @default(autoincrement())
  devolucao_id  Int
  venda_item_id Int
  produto_id    Int
  quantidade    Decimal     @db.Decimal(12, 3)
  valor         Decimal     @db.Decimal(12, 2)
  devolucoes    devolucoes  @relation(fields: [devolucao_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  produtos      produtos    @relation(fields: [produto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  venda_itens   venda_itens @relation(fields: [venda_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model devolucoes {
  id              Int               @id @default(autoincrement())
  venda_id        Int
  usuario_id      Int
  motivo          String?           @db.VarChar(255)
  valor_total     Decimal           @default(0) @db.Decimal(12, 2)
  criado_em       DateTime          @default(now()) @db.Timestamptz(6)
  devolucao_itens devolucao_itens[]
  usuarios        usuarios          @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendas          vendas            @relation(fields: [venda_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([venda_id], map: "idx_devolucoes_venda")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model documentos_fiscais {
  id                  Int       @id @default(autoincrement())
  venda_id            Int?
  tipo                String    @db.VarChar(10)
  numero              String?   @db.VarChar(20)
  serie               String?   @default("1") @db.VarChar(5)
  status              String    @default("pendente") @db.VarChar(15)
  motivo_rejeicao     String?   @db.VarChar(255)
  motivo_cancelamento String?   @db.VarChar(255)
  chave_acesso        String?   @db.VarChar(44)
  usuario_id          Int
  emitido_em          DateTime  @default(now()) @db.Timestamptz(6)
  cancelado_em        DateTime? @db.Timestamptz(6)
  usuarios            usuarios  @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendas              vendas?   @relation(fields: [venda_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "idx_documentos_fiscais_status")
  @@index([venda_id], map: "idx_documentos_fiscais_venda")
}

model fornecedores {
  id                   Int                    @id @default(autoincrement())
  nome                 String                 @db.VarChar(150)
  documento            String?                @db.VarChar(20)
  telefone             String?                @db.VarChar(20)
  email                String?                @db.VarChar(150)
  ativo                Boolean                @default(true)
  criado_em            DateTime               @default(now()) @db.Timestamptz(6)
  produto_fornecedores produto_fornecedores[]
}

model inventario_itens {
  id              Int         @id @default(autoincrement())
  inventario_id   Int
  produto_id      Int
  estoque_sistema Decimal     @db.Decimal(12, 3)
  estoque_contado Decimal?    @db.Decimal(12, 3)
  divergencia     Decimal?    @db.Decimal(12, 3)
  inventarios     inventarios @relation(fields: [inventario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  produtos        produtos    @relation(fields: [produto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([inventario_id], map: "idx_inventario_itens_inv")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventarios {
  id               Int                @id @default(autoincrement())
  usuario_id       Int
  status           String             @default("contagem") @db.VarChar(15)
  criado_em        DateTime           @default(now()) @db.Timestamptz(6)
  finalizado_em    DateTime?          @db.Timestamptz(6)
  inventario_itens inventario_itens[]
  usuarios         usuarios           @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model movimentacoes_estoque {
  id                 Int      @id @default(autoincrement())
  produto_id         Int
  usuario_id         Int
  tipo               String   @db.VarChar(10)
  quantidade         Decimal  @db.Decimal(12, 3)
  estoque_resultante Decimal  @db.Decimal(12, 3)
  motivo             String?  @db.VarChar(255)
  criado_em          DateTime @default(now()) @db.Timestamptz(6)
  produtos           produtos @relation(fields: [produto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios           usuarios @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([produto_id], map: "idx_movimentacoes_produto")
}

model password_resets {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  token      String   @unique @db.VarChar(255)
  expira_em  DateTime @db.Timestamptz(6)
  usado      Boolean  @default(false)
  criado_em  DateTime @default(now()) @db.Timestamptz(6)
  usuarios   usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model produto_fornecedores {
  produto_id    Int
  fornecedor_id Int
  fornecedores  fornecedores @relation(fields: [fornecedor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  produtos      produtos     @relation(fields: [produto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([produto_id, fornecedor_id])
}

model produtos {
  id                     Int                      @id @default(autoincrement())
  nome                   String                   @db.VarChar(150)
  sku                    String?                  @unique @db.VarChar(50)
  categoria_id           Int?
  preco_venda            Decimal                  @default(0) @db.Decimal(12, 2)
  preco_custo            Decimal                  @default(0) @db.Decimal(12, 2)
  estoque_atual          Decimal                  @default(0) @db.Decimal(12, 3)
  estoque_minimo         Decimal                  @default(0) @db.Decimal(12, 3)
  ativo                  Boolean                  @default(true)
  criado_em              DateTime                 @default(now()) @db.Timestamptz(6)
  ncm                    String?                  @db.VarChar(10)
  cfop                   String?                  @db.VarChar(10)
  cest                   String?                  @db.VarChar(10)
  origem_fiscal          String?                  @default("0") @db.VarChar(2)
  codigo_barras          String?                  @unique(map: "idx_produtos_codigo_barras", where: raw("(codigo_barras IS NOT NULL)")) @db.VarChar(50)
  descricao              String?
  grupo                  String?                  @db.VarChar(100)
  unidade_medida         String?                  @default("UN") @db.VarChar(10)
  estoque_maximo         Decimal?                 @db.Decimal(12, 3)
  devolucao_itens        devolucao_itens[]
  inventario_itens       inventario_itens[]
  movimentacoes_estoque  movimentacoes_estoque[]
  produto_fornecedores   produto_fornecedores[]
  categorias             categorias?              @relation(fields: [categoria_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transferencias_estoque transferencias_estoque[]
  venda_itens            venda_itens[]

  @@index([sku], map: "idx_produtos_sku")
}

model transferencias_estoque {
  id         Int      @id @default(autoincrement())
  produto_id Int
  usuario_id Int
  quantidade Decimal  @db.Decimal(12, 3)
  origem     String   @db.VarChar(100)
  destino    String   @db.VarChar(100)
  motivo     String?  @db.VarChar(255)
  criado_em  DateTime @default(now()) @db.Timestamptz(6)
  produtos   produtos @relation(fields: [produto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios   usuarios @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([produto_id], map: "idx_transferencias_produto")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usuarios {
  id                     Int                      @id @default(autoincrement())
  nome                   String                   @db.VarChar(150)
  email                  String                   @unique @db.VarChar(150)
  senha_hash             String                   @db.VarChar(255)
  cargo                  String                   @default("vendedor") @db.VarChar(50)
  ativo                  Boolean                  @default(true)
  criado_em              DateTime                 @default(now()) @db.Timestamptz(6)
  caixa_sessoes          caixa_sessoes[]
  devolucoes             devolucoes[]
  documentos_fiscais     documentos_fiscais[]
  inventarios            inventarios[]
  movimentacoes_estoque  movimentacoes_estoque[]
  password_resets        password_resets[]
  transferencias_estoque transferencias_estoque[]
  vendas                 vendas[]

  @@index([email], map: "idx_usuarios_email")
}

model venda_itens {
  id              Int               @id @default(autoincrement())
  venda_id        Int
  produto_id      Int
  quantidade      Decimal           @db.Decimal(12, 3)
  preco_unitario  Decimal           @db.Decimal(12, 2)
  subtotal        Decimal           @db.Decimal(12, 2)
  devolucao_itens devolucao_itens[]
  produtos        produtos          @relation(fields: [produto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendas          vendas            @relation(fields: [venda_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([venda_id], map: "idx_venda_itens_venda")
}

model vendas {
  id                  Int                  @id @default(autoincrement())
  cliente_id          Int?
  usuario_id          Int
  status              String               @default("aberta") @db.VarChar(20)
  forma_pagamento     String?              @db.VarChar(30)
  desconto            Decimal              @default(0) @db.Decimal(12, 2)
  total               Decimal              @default(0) @db.Decimal(12, 2)
  criado_em           DateTime             @default(now()) @db.Timestamptz(6)
  motivo_cancelamento String?              @db.VarChar(255)
  contas_receber      contas_receber[]
  devolucoes          devolucoes[]
  documentos_fiscais  documentos_fiscais[]
  venda_itens         venda_itens[]
  clientes            clientes?            @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios            usuarios             @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cliente_id], map: "idx_vendas_cliente")
}
